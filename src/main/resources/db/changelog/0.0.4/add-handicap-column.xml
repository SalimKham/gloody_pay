<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd"
>
    <changeSet id="add-handicap-column" author="Salim Kham">
       <addColumn tableName="employee">
           <column name="handicap" type="boolean" defaultValueBoolean="false" afterColumn="employee_title"/>
       </addColumn>
        <sql>
            insert into variable_setting(`key`, source, description, label, formula, company_id)
            select 'HANDICAP', 'HANDICAP', '', 'Travailleur handicapé', '0', id from company;
        </sql>
    </changeSet>
</databaseChangeLog>