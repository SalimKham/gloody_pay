<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd"
>
    <changeSet id="add-payslip-close-table" author="Salim Kham">
      <createTable tableName="payslip_close">
          <column name="id" type="bigint" autoIncrement="true">
              <constraints primaryKey="true" nullable="false"/>
          </column>
          <column name="code" type="VARCHAR(100)">
              <constraints nullable="false"/>
          </column>
          <column name="contract_id" type="bigint">
              <constraints nullable="false"/>
          </column>
          <column name="month" type="date">
              <constraints nullable="false"/>
          </column>
          <column name="base_value" type="double" defaultValueNumeric="0"/>
          <column name="rate_value" type="double" defaultValueNumeric="0"/>
          <column name="value" type="double" defaultValueNumeric="0"/>
      </createTable>
    </changeSet>
</databaseChangeLog>