<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd"
>
    <changeSet id="add-custom-fields" author="Salim Kham">
        <createTable tableName="custom_field">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="value" type="double" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="employee_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="custom_field" baseColumnNames="employee_id"
                                 constraintName="fk_custom_field_to_employee"
                                 referencedTableName="employee"
                                 referencedColumnNames="id"
                                 onUpdate="CASCADE"
                                 onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>