<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd"
>
    <changeSet id="add_column_accounting_code_to_section" author="SALIM KHAM">
        <addColumn tableName="section">
            <column name="accounting_id" type="bigint"/>
        </addColumn>
        <addForeignKeyConstraint baseTableName="section" baseColumnNames="accounting_id" constraintName="fk_section_to_accounting_account"
                                 referencedTableName="accounting_setting_account"
                                 referencedColumnNames="id"
                                 onUpdate="CASCADE"
                                 onDelete="SET NULL"
        />
    </changeSet>

</databaseChangeLog>