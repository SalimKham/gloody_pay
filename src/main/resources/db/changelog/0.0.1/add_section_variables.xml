<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">
        <changeSet id="add_section_variables" author="Salim kham">
         <createTable tableName="section_variable">
             <column name="id" type="bigint" autoIncrement="true">
                 <constraints nullable="false" primaryKey="true"/>
             </column>
             <column name="variable_key" type="VARCHAR(200)"/>
             <column name="variable_value" type="VARCHAR(200)"/>
             <column name="payslip_section_id" type="bigint" >
                 <constraints nullable="false"/>
             </column>
            </createTable>

            <addForeignKeyConstraint baseTableName="section_variable" baseColumnNames="payslip_section_id" constraintName="fk_section_variable_to_section"
                                     referencedTableName="section"
                                     referencedColumnNames="id"
                                     onDelete="CASCADE"
                                     onUpdate="CASCADE"
            />
        </changeSet>
</databaseChangeLog>
