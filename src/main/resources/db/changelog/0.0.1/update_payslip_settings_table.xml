<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd"
>
    <changeSet id="update_payslip_setting_add_employee_and_is_default_columns" author="SALIM KHAM">
        <addColumn tableName="payslip_setting">
            <column name="employee_id" type="bigint" afterColumn="id"/>
            <column name="is_default" type="boolean" afterColumn="template"/>
        </addColumn>
        <sql>
            update payslip_setting ps set ps.is_default=ps.template;
            update payslip_setting ps set ps.template = true;
        </sql>
    </changeSet>
</databaseChangeLog>