<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd"
>
    <changeSet id="add-has-backpayment-to-section-table" author="Salim Kham">
       <addColumn tableName="section">
           <column name="has_backpayment" type="boolean" defaultValueBoolean="false"/>
       </addColumn>
        <sql>
            UPDATE section s SET s.has_backpayment = true WHERE s.label_keys like '%CR_RAPPEL%';
        </sql>
    </changeSet>
</databaseChangeLog>