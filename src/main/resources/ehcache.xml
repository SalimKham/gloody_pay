<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.ehcache.org/v3"
        xsi:schemaLocation="http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core-3.0.xsd">

    <cache alias="sectionMap">
        <key-type>java.lang.Long</key-type>
        <value-type> java.util.Map</value-type>
        <resources>
            <heap unit="MB">5</heap>
            <offheap unit="MB">10</offheap>
        </resources>
    </cache>


    <cache alias="company_variables">
        <key-type>java.lang.Long</key-type>
        <value-type> java.util.List</value-type>
        <resources>
            <heap unit="entries">5</heap>
            <offheap unit="MB">10</offheap>
        </resources>
    </cache>

    <cache alias="company_default_template">
        <key-type>java.lang.Long</key-type>
        <value-type> java.util.Optional</value-type>
        <resources>
            <heap unit="entries">5</heap>
            <offheap unit="MB">2</offheap>
        </resources>
    </cache>

    <cache alias="company_template_by_id">
        <key-type>java.lang.Long</key-type>
        <value-type> java.util.Optional</value-type>
        <resources>
            <heap unit="entries">50</heap>
            <offheap unit="MB">10</offheap>
        </resources>
    </cache>

</config>